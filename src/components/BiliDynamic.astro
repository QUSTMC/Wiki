---
import 'oreui-web/styles.css';
import '../styles/bili.css';
import { biliOptions, type BiliType, type BiliFeed } from '../lib/bili-data';
import { getBiliFeed } from '../lib/bili-service';
import { getBiliSnapshot } from '../lib/bili-snapshot';
import { renderBiliList } from '../lib/bili-render';

interface Props {
	uid: string | number;
	limit?: number;
	type?: BiliType;
	/** Numbers are pixels; strings accept CSS lengths such as "100%" or "32rem". */
	width?: number | string;
	height?: number | string;
	maxWidth?: number | string;
	maxHeight?: number | string;
}
const { width, height, maxWidth, maxHeight } = Astro.props;
const cssSize = (value: number | string | undefined) => typeof value === 'number' ? `${value}px` : value;
const scrollable = height !== undefined || maxHeight !== undefined;
const options = biliOptions(Astro.props.uid, Astro.props.limit ?? 10, Astro.props.type ?? 'all');
const params = new URLSearchParams({ uid: options.uid, limit: String(options.limit), type: options.type });
const publicSnapshotBase = import.meta.env.PUBLIC_BILI_SNAPSHOT_BASE?.replace(/\/$/, '');
if (publicSnapshotBase && new URL(publicSnapshotBase).protocol !== 'https:') throw new Error('PUBLIC_BILI_SNAPSHOT_BASE must use HTTPS');
const endpoint = publicSnapshotBase ? `${publicSnapshotBase}/${options.uid}.json` : `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/bili?${params}`;
let feed: BiliFeed | undefined;
// The first deploy has no live API yet. Reuse the backend fetcher at build time
// when no explicitly configured API is available, without running a local server.
if (!publicSnapshotBase && import.meta.env.BILI_API_BASE) {
	try {
		const response = await fetch(`${import.meta.env.BILI_API_BASE.replace(/\/$/, '')}/api/bili?${params}`, { signal: AbortSignal.timeout(10000) });
		if (response.ok) { const data = await response.json(); if (data.success && Array.isArray(data.items)) feed = data; }
	} catch { /* First deploy or temporarily unavailable proxy. */ }
}
if (!feed) {
	try { feed = (publicSnapshotBase || import.meta.env.BILI_SNAPSHOT_BASE)
		? await getBiliSnapshot(options, publicSnapshotBase || import.meta.env.BILI_SNAPSHOT_BASE)
		: await getBiliFeed(options, import.meta.env.BILI_COOKIE || process.env.BILI_COOKIE || ''); }
	catch { console.warn(`[BiliDynamic] UID ${options.uid}: build-time fetch unavailable; using static link fallback.`); }
}
const items = feed?.items || [];
---
<section class="bili-dynamic not-content" data-bili-dynamic data-scrollable={scrollable || undefined} data-endpoint={endpoint} data-direct-snapshot={publicSnapshotBase ? 'true' : undefined} data-uid={options.uid} data-limit={options.limit} data-type={options.type} data-items={JSON.stringify(items)} data-ready={String(Boolean(feed))} aria-label="B 站动态"
	style={{ '--bili-width': cssSize(width), '--bili-height': cssSize(height), '--bili-max-width': cssSize(maxWidth), '--bili-max-height': cssSize(maxHeight) }}>
	<div class="bili-heading"><h2>B 站动态</h2><a href={`https://space.bilibili.com/${options.uid}/dynamic`} target="_blank" rel="noopener noreferrer">全部动态 ↗</a></div>
	<div class="bili-list" data-bili-list tabindex={scrollable ? 0 : undefined} role={scrollable ? 'region' : undefined} aria-label={scrollable ? '动态列表' : undefined} set:html={renderBiliList(items, feed ? '暂无公开动态。' : '动态暂时无法获取，可前往 B 站查看。')} />
</section>
<script>
	import { renderBiliList } from '../lib/bili-render';
	import type { BiliItem } from '../lib/bili-data';
	import { biliOptions, filterBiliItems, biliImage } from '../lib/bili-data';
	for (const root of document.querySelectorAll<HTMLElement>('[data-bili-dynamic]')) {
		if (root.dataset.initialized) continue;
		root.dataset.initialized = 'true';
		const controller = new AbortController();
		window.addEventListener('pagehide', () => controller.abort(), { once: true });
		const refresh = async () => {
			try {
				const response = await fetch(root.dataset.endpoint!, { signal: AbortSignal.any([controller.signal, AbortSignal.timeout(20000)]), credentials: 'same-origin' });
				if (!response.ok) { console.warn(`[BiliDynamic] Refresh failed (HTTP ${response.status}); keeping existing content.`); return; }
				const data = await response.json();
				if (!data.success || !Array.isArray(data.items)) return;
				if (data.stale && JSON.parse(root.dataset.items || '[]').length) return;
				let items = data.items as BiliItem[];
				if (root.dataset.directSnapshot) {
					if (data.uid !== root.dataset.uid || !Number.isFinite(data.fetchedAt) || Date.now() - data.fetchedAt >= 86400000 || data.fetchedAt > Date.now() + 300000 || items.length > 200) return;
					items = items.map(item => {
						if (!item || typeof item.id !== 'string' || !/^\d+$/.test(item.id) || !Number.isFinite(item.publishedAt) || item.publishedAt <= 0 || typeof item.text !== 'string' || typeof item.title !== 'string' || typeof item.type !== 'string' || !Array.isArray(item.images)) throw new Error('Invalid snapshot');
						return { ...item, text: item.text.slice(0, 10000), title: item.title.slice(0, 300), images: item.images.slice(0, 9).map(biliImage).filter((url): url is string => Boolean(url)) };
					});
					items = [...new Map(items.map(item => [item.id, item])).values()].sort((a, b) => b.publishedAt - a.publishedAt || b.id.localeCompare(a.id));
					items = filterBiliItems(items, biliOptions(root.dataset.uid, root.dataset.limit, root.dataset.type));
					if (Date.now() - data.fetchedAt > 1800000 && JSON.parse(root.dataset.items || '[]').length) return;
				}
				if (!items.length && JSON.parse(root.dataset.items || '[]').length) {
					console.warn('[BiliDynamic] Empty refresh result; keeping existing dynamics.');
					return;
				}
				const signature = JSON.stringify(items);
				if (signature === root.dataset.items && root.dataset.ready === 'true') return;
				const list = root.querySelector<HTMLElement>('[data-bili-list]')!;
				const html = renderBiliList(items);
				if (controller.signal.aborted) return;
				// Restore focus to the same dynamic if it survived the refresh. Avoid
				// silently discarding a focused link when its dynamic was removed.
				const focused = document.activeElement instanceof HTMLElement && list.contains(document.activeElement) ? document.activeElement : undefined;
				const id = focused?.closest<HTMLElement>('[data-dynamic-id]')?.dataset.dynamicId;
				if (id && !items.some(item => item.id === id)) return;
				const animate = !matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in list;
				if (animate) await list.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-out' }).finished;
				if (controller.signal.aborted) return;
				list.innerHTML = html;
				root.dataset.items = signature; root.dataset.ready = 'true';
				if (id) list.querySelector<HTMLElement>(`[data-dynamic-id="${id}"] .bili-detail`)?.focus({ preventScroll: true });
				if (animate) list.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease-out' });
			} catch {
				if (!controller.signal.aborted) console.warn('[BiliDynamic] Refresh unavailable; keeping existing content.');
			}
		};
		// Leave first render to the static HTML. No framework hydration is required.
		if (document.readyState === 'complete') void refresh();
		else window.addEventListener('load', () => void refresh(), { once: true });
	}
</script>
