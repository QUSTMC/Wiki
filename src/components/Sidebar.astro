---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import { Icon } from '@astrojs/starlight/components';

const comicHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/comic/`;
const isComicPage = Astro.url.pathname.startsWith(comicHref);
---

<ul class="top-level comic-sidebar">
	<li>
		<a href={comicHref} aria-current={isComicPage ? 'page' : undefined} class:list={{ large: true, current: isComicPage }}>
			<Icon name="open-book" size="1em" />
			<span>图集</span>
		</a>
	</li>
</ul>
<DefaultSidebar />

<style>
	.comic-sidebar {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.comic-sidebar a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3em 0.5rem;
		border-radius: 0.25rem;
		color: var(--sl-color-gray-2);
		line-height: 1.4;
		text-decoration: none;
		transition: color 0.2s ease, background-color 0.2s ease;
	}
	.comic-sidebar a:hover,
	.comic-sidebar a:focus-visible { color: var(--sl-color-white); }
	.comic-sidebar a.current,
	.comic-sidebar a.current:hover { color: var(--sl-color-text-invert); background: var(--sl-color-text-accent); }
	@media (min-width: 50rem) {
		.comic-sidebar .large { font-size: var(--sl-text-base); }
	}
</style>
