---
import { Image } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import ComicPageStyles from '../../components/ComicPageStyles.astro';
import { comicAlbums, comicUrl } from '../../lib/comics';
---

<StarlightPage frontmatter={{ title: '图集阅读', tableOfContents: false, prev: false, next: false }}>
	<ComicPageStyles />
	<section class="comic-page" aria-label="图集列表">
		{comicAlbums.length > 0 ? (
			<>
				<p class="collection-count">共 {comicAlbums.length} 部</p>
				<div class="comic-grid">
					{comicAlbums.map(({ folder, images }) => (
						<a class="comic-card" href={comicUrl(folder)}>
							<div class="cover">
								<Image src={images[0].src} alt={`${folder} 封面`} width={480} loading="lazy" sizes="(max-width: 50em) 45vw, 240px" />
							</div>
							<div class="card-details">
								<div><span class="album-name">{folder}</span><span class="page-count">{images.length} 页</span></div>
								<Icon name="right-arrow" size="1.25rem" />
							</div>
						</a>
					))}
				</div>
			</>
		) : (
			<div class="empty-state"><Icon name="open-book" size="2.5rem" /><p>暂无图集</p></div>
		)}
	</section>
</StarlightPage>

<style>
	.collection-count { margin: 0 0 1.25rem; color: var(--sl-color-gray-2); font-size: 0.875rem; }
	.comic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 1.25rem; }
	.comic-card {
		display: block; min-width: 0; margin: 0; overflow: hidden;
		border: 1px solid var(--sl-color-gray-5); border-radius: 8px;
		color: var(--sl-color-text); background: var(--sl-color-bg); text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.comic-card:hover { transform: translateY(-3px) scale(1.01); border-color: var(--sl-color-accent); box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
	.comic-card:active { transform: scale(0.99); }
	.cover { aspect-ratio: 3 / 4; overflow: hidden; background: var(--sl-color-gray-6); }
	.cover :global(img) { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; object-position: top; }
	.card-details { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin: 0; padding: 1rem; }
	.card-details > div { min-width: 0; }
	.card-details :global(svg) { flex-shrink: 0; color: var(--sl-color-accent-high); }
	.album-name { display: block; font-size: 1rem; font-weight: 600; overflow-wrap: anywhere; }
	.page-count { display: block; margin-top: 0.25rem; color: var(--sl-color-gray-2); font-size: 0.8125rem; }
	.empty-state { display: grid; justify-items: center; padding: 4rem 1rem; color: var(--sl-color-gray-2); }
</style>
