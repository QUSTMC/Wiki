# Optional: an already deployed proxy origin used during SSG, e.g. https://qustmc.aurelith.top
# When unset/unavailable, the build uses the same server-side fetcher directly.
BILI_API_BASE=
# Optional directory of server-generated public UID.json snapshots (HTTPS preferred).
# Set in BOTH build environment and Worker runtime to avoid direct Bilibili requests.
BILI_SNAPSHOT_BASE=

# Optional server-only cookie. Keep real values out of git and PUBLIC_* variables.
# Used by Astro build/dev. For deployed Workers use: npx wrangler secret put BILI_COOKIE
BILI_COOKIE=
BILI_ALLOWED_UIDS=1933142349
