# Copy OUTSIDE the public JSON directory, to /etc/qust-bili.env, mode 600.
BILI_ALLOWED_UIDS=1933142349
BILI_SNAPSHOT_DIR=/var/lib/qust-bili
BILI_COOKIE="paste the full Cookie value here; omit the Cookie: prefix"

# Optional: upload public snapshots to an R2 bucket after successful collection.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
